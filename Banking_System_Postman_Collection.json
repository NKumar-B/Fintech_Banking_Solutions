{
	"info": {
		"_postman_id": "b1a2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Banking System API Collection",
		"description": "Postman Collection for Fullstack Banking System built with Spring Boot 3 & Java 17.\nIncludes endpoints for:\n1. Customer Creation & Account Opening\n2. Additional Account Opening (1 customer : many accounts)\n3. Account Details & Balance Inquiry\n4. Cash Deposit & Cash Withdrawal\n5. Fund Transfers between Accounts\n6. Transaction History with Pagination & Date Filtering",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api",
			"type": "string"
		},
		{
			"key": "accountNumber1",
			"value": "ACC1000000001",
			"type": "string"
		},
		{
			"key": "accountNumber2",
			"value": "ACC1000000002",
			"type": "string"
		},
		{
			"key": "customerId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Customer Management",
			"item": [
				{
					"name": "Create Customer & Open Initial Account",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1-555-123-4567\",\n  \"address\": \"123 Financial Way, New York, NY\",\n  \"initialAccountType\": \"SAVINGS\",\n  \"initialDeposit\": 5000.00,\n  \"currency\": \"USD\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/customers",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"customers"
							]
						},
						"description": "Creates a new customer and automatically opens an initial bank account for them."
					},
					"response": []
				},
				{
					"name": "Get All Customers",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/customers",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"customers"
							]
						},
						"description": "Retrieves all customers with their associated accounts."
					},
					"response": []
				},
				{
					"name": "Get Customer Details & Accounts by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/customers/{{customerId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"customers",
								"{{customerId}}"
							]
						},
						"description": "Retrieves customer information and all their associated bank accounts."
					},
					"response": []
				},
				{
					"name": "Get Accounts for Customer",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/customers/{{customerId}}/accounts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"customers",
								"{{customerId}}",
								"accounts"
							]
						},
						"description": "Retrieves only the accounts belonging to a specific customer."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Account Operations",
			"item": [
				{
					"name": "Open Secondary Account for Customer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": 1,\n  \"accountType\": \"CHECKING\",\n  \"initialBalance\": 2500.00,\n  \"currency\": \"USD\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/accounts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"accounts"
							]
						},
						"description": "Demonstrates 1 customer having multiple bank accounts."
					},
					"response": []
				},
				{
					"name": "Get All Bank Accounts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/accounts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"accounts"
							]
						},
						"description": "Lists all bank accounts across all customers."
					},
					"response": []
				},
				{
					"name": "Get Account Details & Balance",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/accounts/{{accountNumber1}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"accounts",
								"{{accountNumber1}}"
							]
						},
						"description": "Gets full details for a specific account including balance, type, and status."
					},
					"response": []
				},
				{
					"name": "Get Real-Time Balance Only",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/accounts/{{accountNumber1}}/balance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"accounts",
								"{{accountNumber1}}",
								"balance"
							]
						},
						"description": "Fetches current account balance."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Deposits & Withdrawals",
			"item": [
				{
					"name": "Deposit Money",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 750.00,\n  \"description\": \"Salary Deposit\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/accounts/{{accountNumber1}}/deposit",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"accounts",
								"{{accountNumber1}}",
								"deposit"
							]
						},
						"description": "Deposits money into account and returns new balance."
					},
					"response": []
				},
				{
					"name": "Withdraw Money",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 200.00,\n  \"description\": \"ATM Cash Withdrawal\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/accounts/{{accountNumber1}}/withdraw",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"accounts",
								"{{accountNumber1}}",
								"withdraw"
							]
						},
						"description": "Withdraws money from account if balance is sufficient."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Fund Transfers",
			"item": [
				{
					"name": "Transfer Funds Between Two Accounts",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fromAccountNumber\": \"{{accountNumber1}}\",\n  \"toAccountNumber\": \"{{accountNumber2}}\",\n  \"amount\": 500.00,\n  \"description\": \"Payment for services\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/transfers",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"transfers"
							]
						},
						"description": "Atomically transfers funds from source account to destination account."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Transaction History",
			"item": [
				{
					"name": "Get Transaction History (Default Page 0)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/accounts/{{accountNumber1}}/transactions?page=0&size=10&sortBy=timestamp&sortDir=DESC",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"accounts",
								"{{accountNumber1}}",
								"transactions"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								},
								{
									"key": "sortBy",
									"value": "timestamp"
								},
								{
									"key": "sortDir",
									"value": "DESC"
								}
							]
						},
						"description": "Retrieves paginated transaction history sorted by newest first."
					},
					"response": []
				},
				{
					"name": "Get Transaction History (With Date Range Filter & Pagination)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/accounts/{{accountNumber1}}/transactions?startDate=2026-09-01T00:00:00&endDate=2026-09-30T23:59:59&page=0&size=5&sortBy=timestamp&sortDir=DESC",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"accounts",
								"{{accountNumber1}}",
								"transactions"
							],
							"query": [
								{
									"key": "startDate",
									"value": "2026-09-01T00:00:00",
									"description": "ISO format date start filter"
								},
								{
									"key": "endDate",
									"value": "2026-09-30T23:59:59",
									"description": "ISO format date end filter"
								},
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "5"
								},
								{
									"key": "sortBy",
									"value": "timestamp"
								},
								{
									"key": "sortDir",
									"value": "DESC"
								}
							]
						},
						"description": "Retrieves transaction history filtered by start date, end date, and page 0 size 5."
					},
					"response": []
				}
			]
		}
	]
}
